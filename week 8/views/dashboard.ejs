<!DOCTYPE html>
<html>
<head>
    <title>Dashboard</title>
</head>

<body>

    <h1>
        Welcome to the Private Dashboard, <%= user %>!
    </h1>

    <p>
        <strong>Session Info:</strong>
        You are logged in using express-session.
    </p>

    <p>
        <strong>Cookie Data:</strong>
        Your last login was at:
        <%= lastVisit %>
    </p>

    <hr>

    <a href="/logout">
        Logout
    </a>

</body>
</html>